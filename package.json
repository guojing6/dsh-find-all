{
  "name": "@guojing6/dsh-find-all",
  "version": "0.4.0",
  "description": "Find saved conversation text across DeepSeek Harness (DSH), with Ctrl+F / Cmd+F inside a conversation.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "NOTICE.md",
    "docs/compatibility.md",
    "LICENSE"
  ],
  "author": "guojing6",
  "contributors": [
    "Ryuu-64 (dsh-find-all upstream, MIT)",
    "secyborg (upstream dsh-find-bar, MIT)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guojing6/dsh-find-all.git"
  },
  "homepage": "https://github.com/guojing6/dsh-find-all#readme",
  "bugs": {
    "url": "https://github.com/guojing6/dsh-find-all/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "check:registration": "node scripts/check-client-registration.mjs",
    "check": "npm run check:build && node --check lib/index.js && node --check lib/client.js && npm run check:registration && node --test \"test/**/*.test.mjs\"",
    "verify:release": "node scripts/verify-release.mjs",
    "install:local": "node scripts/install-local.mjs",
    "deploy:profile": "node scripts/deploy-profile.mjs",
    "build": "node scripts/build-client.mjs",
    "check:build": "node scripts/build-client.mjs --check"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "find",
    "search",
    "conversation",
    "conversation-search",
    "ctrl-f"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "jsdom": "27.4.0",
    "playwright": "1.56.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "semver": "7.8.5"
  }
}
